# Build-time configuration.
# Copy to `.env` and adjust before `npm run build`.

# Canonical origin used for canonical URLs, hreflang, OG tags, JSON-LD, sitemap.
SITE_URL=https://fahherd.github.io

# Base path. Use `/` for a user site or custom domain,
# or `/<repository-name>` for a GitHub Pages project site.
BASE_PATH=/
