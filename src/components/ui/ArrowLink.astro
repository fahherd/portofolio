---
import Icon from './Icon.astro';

interface Props {
  href: string;
  external?: boolean;
  externalLabel?: string;
  icon?: 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'external' | 'mail' | 'github';
  class?: string;
}

const {
  href,
  external = false,
  externalLabel,
  icon = 'arrow-right',
  class: className,
} = Astro.props;
---

<a
  class:list={['text-link', className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span><slot /></span>
  <Icon name={icon} size={16} />
  {external && externalLabel && (
    <span class="u-visually-hidden"> ({externalLabel})</span>
  )}
</a>

<style>
  .text-link {
    min-height: 36px;
  }
</style>
