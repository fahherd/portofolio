---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import Hero from '../sections/Hero.astro';
import Intro from '../sections/Intro.astro';
import SelectedWork from '../sections/SelectedWork.astro';
import Expertise from '../sections/Expertise.astro';
import Experience from '../sections/Experience.astro';
import Recognition from '../sections/Recognition.astro';
import Contact from '../sections/Contact.astro';

interface Props {
  locale: Locale;
  caseStudies: CollectionEntry<'projects'>[];
  repositories: CollectionEntry<'projects'>[];
}

const { locale, caseStudies, repositories } = Astro.props;
---

<Hero locale={locale} />
<Intro locale={locale} />
<SelectedWork
  locale={locale}
  caseStudies={caseStudies}
  repositories={repositories}
/>
<Expertise locale={locale} />
<Experience locale={locale} />
<Recognition locale={locale} />
<Contact locale={locale} />
