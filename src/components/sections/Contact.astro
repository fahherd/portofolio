---
import type { Locale } from '../../i18n/config';
import { getUI } from '../../i18n/ui';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const contact = site.contact[locale];

const socials = [
  {
    label: 'GitHub',
    href: site.github,
    description: ui.actions.viewRepository,
    icon: 'github' as const,
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    description: ui.actions.connectLinkedin,
    icon: 'linkedin' as const,
  },
  {
    label: 'Instagram',
    href: site.instagram,
    description: ui.actions.visitInstagram,
  },
];
---

<section id="contact" class="section section--light contact">
  <div class="container">
    <div class="contact__top">
      <span class="eyebrow contact__label">
        <span aria-hidden="true">[06]</span>
        / {ui.sections.contact.label}
      </span>
      <span class="eyebrow contact__location">{site.location}</span>
    </div>

    <h2
      class="contact__headline display"
      aria-label={contact.lines.map((line) => line.text).join(' ')}
    >
      {
        contact.lines.map((line) => (
          <span
            class:list={['contact__line', { 'contact__line--emphasis': line.emphasis }]}
          >
            {line.text}
          </span>
        ))
      }
    </h2>

    <div class="contact__grid">
      <div class="contact__primary">
        <p class="eyebrow contact__email-label">{contact.emailLabel}</p>
        <a class="contact__email" href={`mailto:${site.email}`}>
          <span>{site.email}</span>
          <Icon name="arrow-up-right" size={28} />
        </a>
        <p class="contact__lede">{contact.lede}</p>
      </div>

      <ul class="contact__socials">
        {
          socials.map((social, index) => (
            <li>
              <a
                class="contact__social"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="eyebrow contact__social-index">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="contact__social-name serif">{social.label}</span>
                <span class="contact__social-desc eyebrow">
                  {social.description}
                </span>
                <Icon name="arrow-up-right" size={20} />
                <span class="u-visually-hidden">({ui.labels.externalLink})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="contact__bottom">
      <p class="eyebrow">{ui.footer.closing}</p>
      <p class="eyebrow contact__email-copy">
        {site.email} — {site.location}
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--border-light);
    background:
      radial-gradient(
        70% 90% at 100% 0%,
        rgba(232, 173, 50, 0.14) 0%,
        transparent 60%
      ),
      var(--color-light-50);
  }

  .contact__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .contact__label {
    color: var(--text);
  }

  .contact__headline {
    display: flex;
    flex-direction: column;
    gap: 0.04em;
    margin-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    font-size: clamp(2.75rem, 6.4vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--text);
  }

  .contact__line--emphasis {
    font-style: italic;
    color: var(--accent-text);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .contact__primary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__email-label {
    color: var(--muted);
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    align-self: flex-start;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    transition:
      color var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard);
  }

  .contact__email :global(svg) {
    flex: 0 0 auto;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .contact__email:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }

  .contact__email:hover :global(svg) {
    transform: translate(4px, -4px);
  }

  .contact__lede {
    max-width: 48ch;
    color: var(--muted);
    font-size: var(--text-body-md);
    line-height: 1.65;
  }

  .contact__socials {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .contact__socials li {
    border-bottom: 1px solid var(--border);
  }

  .contact__social {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .contact__social:hover {
    color: var(--accent-text);
  }

  .contact__social-index {
    color: var(--muted);
  }

  .contact__social-name {
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    line-height: 1.1;
  }

  .contact__social-desc {
    grid-column: 2;
    color: var(--muted);
  }

  .contact__social :global(svg) {
    grid-column: 3;
    grid-row: 1 / span 2;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .contact__social:hover :global(svg) {
    transform: translate(4px, -4px);
  }

  .contact__bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .contact__email-copy {
    text-align: right;
  }

  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  @media (max-width: 768px) {
    .contact__headline {
      font-size: clamp(2.4rem, 9.5vw, 3.5rem);
    }
  }

  @media (max-width: 640px) {
    .contact__top,
    .contact__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .contact__email {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
      gap: var(--space-2);
    }

    .contact__email :global(svg) {
      width: 20px;
      height: 20px;
    }

    .contact__email-copy {
      text-align: left;
    }
  }
</style>
