---
import type { Locale } from '../../i18n/config';
import { getUI } from '../../i18n/ui';
import { site } from '../../data/site';
import { withBase } from '../../utils/url';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const about = site.about[locale];
---

<section id="about" class="section section--light about">
  <div class="container">
    <SectionHeading
      number="01"
      label={ui.sections.about.label}
      title={ui.sections.about.title}
    />

    <div class="about__grid">
      <figure class="about__figure" data-reveal-media>
        {
          site.portrait.src ? (
            <img
              class="about__portrait"
              src={withBase(site.portrait.src)}
              alt={site.portrait.alt}
              width={1086}
              height={1448}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="about__plate" aria-hidden="true">
              <span class="about__plate-index eyebrow">IDENTITY</span>
              {/* <span class="about__plate-monogram serif">
                FH<span>.</span>
              </span> */}
              <span class="about__plate-rule"></span>
              {/* <div class="about__plate-footer">
                <span class="eyebrow">Fajar Herdiansyah</span>
                <span class="eyebrow">Bekasi, ID</span>
              </div> */}
            </div>
          )
        }
        <figcaption class="about__caption eyebrow">
          {about.portraitCaption}
        </figcaption>
      </figure>

      <div class="about__body" data-reveal>
        <p class="about__lede serif">{about.lede}</p>

        <div class="about__paragraphs">
          {about.paragraphs.map((paragraph) => <p class="body-lg">{paragraph}</p>)}
        </div>

        <blockquote class="about__quote">
          <span class="about__quote-mark serif" aria-hidden="true">“</span>
          <p class="serif">{about.quote}</p>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: start;
  }

  .about__figure {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
  }

  .about__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    overflow: hidden;
    background:
      linear-gradient(
        to right,
        transparent calc(50% - 1px),
        rgba(23, 23, 23, 0.09) 50%,
        transparent calc(50% + 1px)
      ),
      linear-gradient(
        to bottom,
        transparent calc(66.666% - 1px),
        rgba(23, 23, 23, 0.09) 66.666%,
        transparent calc(66.666% + 1px)
      ),
      var(--color-light-200);
    border: 1px solid var(--border-light);
  }

  .about__plate-index {
    color: var(--color-text-muted-dark);
  }

  .about__plate-monogram {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(6rem, 13vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--color-text-dark);
    white-space: nowrap;
  }

  .about__plate-monogram span {
    color: var(--color-accent-dark);
  }

  .about__plate-rule {
    position: absolute;
    left: clamp(1.25rem, 2.4vw, 2rem);
    right: clamp(1.25rem, 2.4vw, 2rem);
    bottom: 22%;
    height: 1px;
    background: rgba(23, 23, 23, 0.14);
  }

  .about__plate-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted-dark);
  }

  .about__caption {
    color: var(--muted);
  }

  .about__body {
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    padding-top: var(--space-2);
  }

  .about__lede {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--text);
    max-width: 24ch;
  }

  .about__paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--muted);
    max-width: 58ch;
  }

  .about__paragraphs p {
    font-size: var(--text-body-md);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .about__quote {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .about__quote-mark {
    font-size: 3rem;
    line-height: 0.8;
    color: var(--accent-text);
  }

  .about__quote p {
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
    max-width: 30ch;
  }

  @media (max-width: 1024px) {
    .about__figure {
      grid-column: 1 / span 4;
    }

    .about__body {
      grid-column: 6 / span 7;
    }
  }

  @media (max-width: 768px) {
    .about__figure {
      position: static;
      grid-column: 1 / -1;
      max-width: 26rem;
    }

    .about__body {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .about__figure {
      max-width: none;
    }

    .about__plate-monogram {
      font-size: clamp(6rem, 34vw, 9rem);
    }
  }
</style>
