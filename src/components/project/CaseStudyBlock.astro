---
interface Props {
  id: string;
  number: string;
  label: string;
  class?: string;
}

const { id, number, label, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['case-block', className]}
  data-case-section
  aria-labelledby={`${id}-title`}
>
  <div class="case-block__marker">
    <span class="eyebrow case-block__number">[{number}]</span>
    <h2 id={`${id}-title`} class="case-block__label serif">{label}</h2>
  </div>

  <div class="case-block__content">
    <slot />
  </div>
</section>

<style>
  .case-block {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(0, 7.5fr);
    gap: var(--space-6) var(--space-8);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--border);
  }

  .case-block:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .case-block__marker {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--muted);
  }

  .case-block__number {
    color: var(--accent-text);
  }

  .case-block__label {
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .case-block__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    max-width: 68ch;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .case-block {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .case-block__marker {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }
  }
</style>
