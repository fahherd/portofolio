---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';

import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/animations.css';

import type { Locale } from '../i18n/config';
import { htmlLang, ogLocale } from '../i18n/config';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import Header from '../components/layout/Header.astro';
import MenuOverlay from '../components/layout/MenuOverlay.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPath: string;
  alternatePath: string;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  preserveHash?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  locale,
  title,
  description,
  currentPath,
  alternatePath,
  ogType = 'website',
  image = '/images/og-default.jpg',
  noindex = false,
  preserveHash = false,
  jsonLd,
  bodyClass,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://fahherd.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const alternateUrl = new URL(alternatePath, siteUrl).href;
const defaultPath = locale === 'id' ? currentPath : alternatePath;
const defaultUrl = new URL(defaultPath, siteUrl).href;
const ogImage = new URL(withBase(image), siteUrl).href;

const person = {
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: new URL(withBase(`${locale}/`), siteUrl).href,
  sameAs: [site.github, site.linkedin],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bekasi',
    addressCountry: 'ID',
  },
};

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ],
});

const safeStructuredData = structuredData.replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101010" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={locale === 'id' ? canonical : alternateUrl} />
    <link rel="alternate" hreflang="en" href={locale === 'en' ? canonical : alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta
      property="og:locale:alternate"
      content={ogLocale[locale === 'id' ? 'en' : 'id']}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={safeStructuredData} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body
    id="top"
    class={bodyClass}
    style={`--noise-image: url('${withBase('/images/noise.webp')}')`}
  >
    <a class="skip-link" href="#main">
      {locale === 'id' ? 'Lewati ke konten utama' : 'Skip to main content'}
    </a>

    <Header
      locale={locale}
      currentPath={currentPath}
      alternatePath={alternatePath}
      preserveHash={preserveHash}
    />

    <MenuOverlay
      locale={locale}
      currentPath={currentPath}
      alternatePath={alternatePath}
      preserveHash={preserveHash}
    />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
